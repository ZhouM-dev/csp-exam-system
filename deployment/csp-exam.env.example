# Install as /etc/csp-exam.env; use the actual CSP subdomain.
CSP_EXAM_BIND=127.0.0.1
CSP_EXAM_PORT=8081
CSP_EXAM_DATA_DIR=/var/lib/csp-exam
CSP_EXAM_LOG_DIR=/var/log/csp-exam
CSP_EXAM_COOKIE_SECURE=1
CSP_EXAM_PUBLIC_ORIGIN=https://csp.example.com
# Dedicated CSP sandbox. LiteOJ currently owns port 5050.
CSP_GOJUDGE_URL=http://127.0.0.1:5060
CSP_HYDRO_URL=http://127.0.0.1:8082
# Generate a private token; use the same value in the Hydro container environment.
# CSP_HYDRO_TOKEN=<random private token of at least 32 characters>
CSP_JUDGE_MIN_AVAILABLE_MB=1536
CSP_MAX_PS_UPLOAD_MB=64
